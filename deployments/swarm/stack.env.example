# Copy to stack.env (gitignored) and replace every CHANGE_ME, then export it into
# the shell that runs `docker stack deploy` (stack deploy does NOT read .env files):
#   set -a; . ./stack.env; set +a
#   docker stack deploy --with-registry-auth -c docker-stack.yml resume
# Use hex/alphanumeric passwords (POSTGRES_PASSWORD is embedded in DATABASE_URL).

TAG=sha-0000000                     # immutable CI tag, e.g. sha-1a2b3c4 or v1.0.0
CFG_REV=1                           # bump when you change a swarm config file (configs are immutable)

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com
TRAEFIK_DOMAIN=traefik.example.com
PORTAINER_DOMAIN=portainer.example.com

ACME_EMAIL=ops@example.com
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# staging while testing: https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_USER=resume_review
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=resume_review

ENVIRONMENT=production
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
CORS_ORIGINS=https://app.example.com
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

FLET_SECRET_KEY=CHANGE_ME
REQUEST_TIMEOUT=15

# monitoring stack (docker-stack.monitoring.yml)
ELASTIC_PASSWORD=CHANGE_ME
ES_JAVA_OPTS="-Xms512m -Xmx512m"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
