# Copy to deployments/docker/.env  (gitignored) and replace every CHANGE_ME.
#   cp .env.example .env
# docker compose reads ./.env automatically for ${VAR} interpolation; the compose
# file then passes only the variables each container needs (no blanket env_file).
# Generate secrets with:  openssl rand -hex 32
# Use hex/alphanumeric passwords: POSTGRES_PASSWORD is embedded in DATABASE_URL
# without URL-encoding.

COMPOSE_PROJECT_NAME=resume-review

# ---- images ---------------------------------------------------------------
# Pin to an immutable CI tag in production, e.g. TAG=sha-1a2b3c4 or v1.0.0
TAG=latest
BACKEND_IMAGE=docker.io/sepehrmdn/resume-review-backend
FRONTEND_IMAGE=docker.io/sepehrmdn/resume-review-frontend

# ---- public hostnames (DNS A/AAAA must point to this host) -----------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com        # profile: monitoring
TRAEFIK_DOMAIN=traefik.example.com        # Traefik dashboard (basic auth)
PORTAINER_DOMAIN=portainer.example.com    # profile: ops

# ---- TLS / ACME ------------------------------------------------------------
ACME_EMAIL=ops@example.com
# Production CA (default). While testing use staging to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# ---- database --------------------------------------------------------------
POSTGRES_USER=resume_review
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=resume_review

# ---- backend ---------------------------------------------------------------
ENVIRONMENT=production
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
CORS_ORIGINS=https://app.example.com      # exact origins, comma-separated
MAX_UPLOAD_MB=10
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# ---- frontend --------------------------------------------------------------
FLET_SECRET_KEY=CHANGE_ME
REQUEST_TIMEOUT=15

# ---- monitoring (profile: monitoring) --------------------------------------
ELASTIC_PASSWORD=CHANGE_ME
ES_JAVA_OPTS="-Xms512m -Xmx512m"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
