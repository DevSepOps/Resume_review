# Resume Review frontend (Flet) - copy to .env and adjust. See docs/architecture/contracts.md section 3.
BACKEND_URL=http://backend:8000
FLET_HOST=0.0.0.0
FLET_PORT=8001
# REQUIRED: signs browser upload URLs. Generate with: openssl rand -hex 32
FLET_SECRET_KEY=change-me
UPLOAD_TMP_DIR=/tmp/uploads
REQUEST_TIMEOUT=15
# Optional: client-side upload size limit in MB (keep equal to backend MAX_UPLOAD_MB)
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
