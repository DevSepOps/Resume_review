# Backend environment (copy to .env / inject via secrets). Contract: docs/architecture/contracts.md
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- required ---
DATABASE_URL=postgresql+psycopg2://resume:CHANGE_ME@db:5432/resume_review
JWT_SECRET_KEY=CHANGE_ME_to_at_least_32_random_characters

# --- optional (defaults shown) ---
ENVIRONMENT=development
CORS_ORIGINS=
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=10
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
LOG_LEVEL=INFO
DB_ECHO=false
RUN_MIGRATIONS=true
DB_WAIT_TIMEOUT=60
WEB_CONCURRENCY=2
