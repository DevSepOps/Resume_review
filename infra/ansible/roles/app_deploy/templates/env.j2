# Managed by Ansible (role app_deploy). Do not edit by hand; changes are overwritten.
# Keys mirror deployments/docker/.env.example. Use hex/alphanumeric secrets
# (POSTGRES_PASSWORD is embedded in DATABASE_URL by compose without URL-encoding).

COMPOSE_PROJECT_NAME=resume-review

TAG={{ image_tag }}
BACKEND_IMAGE={{ backend_image }}
FRONTEND_IMAGE={{ frontend_image }}

APP_DOMAIN={{ app_domain }}
API_DOMAIN={{ api_domain }}
GRAFANA_DOMAIN={{ grafana_domain }}
TRAEFIK_DOMAIN={{ traefik_domain }}
PORTAINER_DOMAIN={{ portainer_domain }}

ACME_EMAIL={{ acme_email }}
ACME_CA_SERVER={{ acme_ca_server }}

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}

ENVIRONMENT={{ app_environment }}
JWT_SECRET_KEY={{ vault_jwt_secret_key }}
CORS_ORIGINS={{ cors_origins }}

FLET_SECRET_KEY={{ vault_flet_secret_key }}

ELASTIC_PASSWORD={{ vault_elastic_password }}
GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
{% for key, value in app_env_extra.items() %}
{{ key }}={{ value }}
{% endfor %}
